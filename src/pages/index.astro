---
import Base from "../layouts/Base.astro";
import { boda, navegacion } from "../config.js";
import { enlace } from "../enlaces.js";

const [nombre1, nombre2] = boda.nombres;
const ruta = Astro.url.pathname;
---
<Base titulo={`${nombre1} y ${nombre2}`}>

  <header class="portada">
    <p class="portada__lugar">{boda.lugar}</p>

    <h1 class="portada__nombres">
      <span class="portada__nombre">{nombre1}</span>
      <span class="portada__y">y</span>
      <span class="portada__nombre">{nombre2}</span>
    </h1>

    <p class="portada__fecha">
      <time datetime={boda.fecha.slice(0, 16)}>{boda.fechaTexto}</time>
    </p>

    <p class="portada__cuenta" id="cuenta-atras" data-fecha={boda.fecha} hidden></p>

    <p class="portada__rsvp"><a class="boton" href="/confirmar/">Confirmar asistencia</a></p>

    <nav class="indice" aria-label="Secciones">
      {/* La confirmación ya tiene su botón justo encima. */}
      {navegacion.filter((item) => item.ruta !== "/confirmar/").map((item) => <a href={enlace(item, ruta)}>{item.texto}</a>)}
    </nav>
  </header>

  <figure class="foto">
    <img src="/img/portada.jpg" alt="" width="1800" height="1000">
  </figure>

  <main>

    <section class="seccion" id="dia" aria-labelledby="dia-titulo">
      <span class="icono seccion__icono" data-icono="brindis" aria-hidden="true"></span>
      <h2 class="seccion__titulo" id="dia-titulo">El día</h2>
      <p class="seccion__intro">La ceremonia será a las 12:30 en la parroquia de San Ignacio. Después iremos todos juntos a la finca para comer y celebrarlo.</p>

      <div class="seccion__contenido">

        <ol class="horario">
          <li class="horario__item">
            <span class="icono horario__icono" data-icono="iglesia" aria-hidden="true"></span>
            <time class="horario__hora" datetime="12:30">12:30</time>
            <div class="horario__detalle">
              <h3>Ceremonia</h3>
              <p>Parroquia de San Ignacio</p>
              <p class="dato-secundario">Zabaleta Kalea, 18, 20002 Donostia / San Sebastián, Gipuzkoa</p>
              {/* <a class="enlace" href="https://www.openstreetmap.org/search?query=Plaza%20Mayor%201%20Villanueva" target="_blank" rel="noopener noreferrer">Ver en el mapa</a> */}
            </div>
          </li>
          <li class="horario__item">
            <span class="icono horario__icono" data-icono="celebracion" aria-hidden="true"></span>
            <time class="horario__hora" datetime="14:00">14:00</time>
            <div class="horario__detalle">
              <h3>Celebración</h3>
              <p>Finca Machoenia</p>
              <p class="dato-secundario">Vieille Route d'Espagne, 64122 Urrugne, Francia</p>
              <a class="enlace" href="https://www.openstreetmap.org/search?query=Camino%20de%20los%20Olmos%20Villanueva" target="_blank" rel="noopener noreferrer">Ver en el mapa</a>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="seccion" id="transporte" aria-labelledby="transporte-titulo">
      <span class="icono seccion__icono" data-icono="autobus" aria-hidden="true"></span>
      <h2 class="seccion__titulo" id="transporte-titulo">Transporte</h2>
      <p class="seccion__intro">Habrá autobuses de ida y vuelta desde la ciudad. Salen a las 13:45 desde la parroquia.</p>

        <div class="seccion__contenido">

        {/* <div class="paradas">
          <article class="parada">
            <h3>Parada Centro</h3>
            <p>Frente a la estación de tren</p>
            <p class="dato-secundario">Salida a las 11:00</p>
            <a class="enlace" href="https://www.openstreetmap.org/search?query=estaci%C3%B3n%20de%20tren" target="_blank" rel="noopener noreferrer">Ver en el mapa</a>
          </article>
          <article class="parada">
            <h3>Parada Playa</h3>
            <p>Paseo Marítimo, junto al kiosco</p>
            <p class="dato-secundario">Salida a las 11:00</p>
            <a class="enlace" href="https://www.openstreetmap.org/search?query=paseo%20mar%C3%ADtimo" target="_blank" rel="noopener noreferrer">Ver en el mapa</a>
          </article>
        </div> */}

        <h3 class="subtitulo">Ida</h3>
        <dl class="vuelta">
          <div class="vuelta__fila">
            <dt>13:45</dt>
            <dd>Desde la parroquia de San Ignacio</dd>
          </div>
        </dl>

        <h3 class="subtitulo">Vuelta</h3>
        <dl class="vuelta">
          <div class="vuelta__fila">
            <dt>23:00</dt>
            <dd>Para quien quiera retirarse pronto</dd>
          </div>
          <div class="vuelta__fila">
            <dt>02:00</dt>
            <dd>Para quien quiera cerrar la fiesta</dd>
          </div>
        </dl>
        <p class="nota">Todos los autobuses de vuelta paran en las dos paradas.</p>
        </div>
      </section>

    <section class="seccion" id="alojamiento" aria-labelledby="alojamiento-titulo">
      <span class="icono seccion__icono" data-icono="alojamiento" aria-hidden="true"></span>
      <h2 class="seccion__titulo" id="alojamiento-titulo">Alojamiento</h2>
      <p class="seccion__intro">Estos hoteles están cerca de las paradas del autobús. Si pensáis quedaros a dormir, os recomendamos reservar pronto.</p>

      <div class="seccion__contenido">

        <ul class="hoteles">
          <li class="hotel">
            <span class="hotel__nombre">Hotel Distrito Oeste</span>
            <span class="hotel__estrellas" role="img" aria-label="3 estrellas">★★★</span>
            {/* <span class="hotel__detalle">Paseo Marítimo · a 2 min de la parada Playa</span> */}
            {/* <a class="enlace" href="https://www.openstreetmap.org/search?query=paseo%20mar%C3%ADtimo" target="_blank" rel="noopener noreferrer">Ver en el mapa</a> */}
          </li>
          <li class="hotel">
            <span class="hotel__nombre">Hotel Barceló Costa Vasca</span>
            <span class="hotel__estrellas" role="img" aria-label="4 estrellas">★★★★</span>
            {/* <span class="hotel__detalle">Centro · a 3 min de la parada Centro</span> */}
            {/* <a class="enlace" href="https://www.openstreetmap.org/search?query=estaci%C3%B3n%20de%20tren" target="_blank" rel="noopener noreferrer">Ver en el mapa</a> */}
          </li>
        </ul>
      </div>
    </section>

    <section class="seccion" id="contactos" aria-labelledby="contactos-titulo">
      <span class="icono seccion__icono" data-icono="telefono" aria-hidden="true"></span>
      <h2 class="seccion__titulo" id="contactos-titulo">Contactos útiles</h2>
      <p class="seccion__intro">Si preferís ir por vuestra cuenta, estos servicios conocen bien la zona.</p>

      <div class="seccion__contenido">

        <ul class="contactos">
          <li class="contacto">
            <span class="contacto__nombre">Radio Taxi Villanueva</span>
            <a class="contacto__dato" href="tel:+34900000000">900 000 000</a>
          </li>
          <li class="contacto">
            <span class="contacto__nombre">Traslados del Norte</span>
            <a class="contacto__dato" href="tel:+34600000000">600 000 000</a>
          </li>
        </ul>
      </div>
    </section>

    <section class="seccion seccion--regalo" id="regalo" aria-labelledby="regalo-titulo">
      <span class="icono seccion__icono" data-icono="regalo" aria-hidden="true"></span>
      <h2 class="seccion__titulo" id="regalo-titulo">Regalo</h2>
      <p class="seccion__intro">Lo más importante es que vengáis. Si aun así queréis tener un detalle con nosotros, podéis hacerlo aquí.</p>

      <div class="seccion__contenido">

        <div class="cuenta">
          <p class="cuenta__etiqueta" id="iban-etiqueta">Número de cuenta</p>
          <p class="cuenta__numero" id="iban" aria-labelledby="iban-etiqueta">ES00 0000 0000 0000 0000 0000</p>
          <button class="boton js-solo" type="button" data-copiar="iban" hidden>Copiar número</button>
          <p class="cuenta__aviso" role="status" aria-live="polite"></p>
        </div>
      </div>
    </section>

  </main>

</Base>
